# Andhra Ruchulu - Environment Variables Example
# Copy this file to .env.local and fill in your values. Never commit .env.local!

# ==========================================
# 1. Site Configuration
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# 2. AI / LLM Inference Providers
# ==========================================
# Primary Google Gemini API Key (for Ruchi AI Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Optional: OpenRouter API Key (fallback multi-model inference for Ruchi AI)
OPENROUTER_API_KEY=your-openrouter-api-key

# ==========================================
# 3. Cloudinary CDN & Asset Storage
# ==========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloud-name

# ==========================================
# 4. UI Libraries
# ==========================================
REACTBITS_LICENSE_KEY=your-reactbits-license-key
